{
  "namespace": "default",
  "download_base": "downloads",
  "pool": 16,
  "threads": 8,
  "limit": 4,
  "jobs": [
    {
      "chat_url": "https://t.me/example_channel",
      "follow_links": true,
      "subdir": "linked-archive",
      "max_posts": 1,
      "link_options": {
        "scan_comments": true,
        "include_previews": true,
        "cleanup_bot_messages": true,
        "max_depth": 8,
        "max_links": 100,
        "bot_timeout_seconds": 60,
        "bot_idle_seconds": 3,
        "poll_interval_ms": 500,
        "max_bot_messages": 500,
        "comment_limit": 100,
        "rerequest_limit": 3,
        "flood_retries": 5,
        "flood_wait_seconds": 30,
        "max_flood_wait_seconds": 3600
      }
    }
  ]
}
